local function Destroy()
	if Dead then return end
	Dead = true
	for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
	pcall(function() RunService:UnbindFromRenderStep("XG_Render") end)

	-- give everything back to the game
	for inst, props in pairs(Orig) do
		for prop, ov in pairs(props) do
			pcall(function() inst[prop] = ov end)
		end
	end
	for inst, parent in pairs(Removed) do
		pcall(function() inst.Parent = parent end)
	end
	pcall(Core.restoreCustomTex)
	pcall(Core.destroyScanner)
	pcall(Core.destroyEffects)
	pcall(Core.destroyOverlay)
	pcall(Core.destroyParticles)

	pcall(function() RunService:Set3dRenderingEnabled(true) end)
	if Saved.quality ~= nil then pcall(function() settings().Rendering.QualityLevel = Saved.quality end) end
	if Saved.mesh ~= nil then pcall(function() settings().Rendering.MeshPartDetailLevel = Saved.mesh end) end
	if Saved.hd ~= nil then pcall(function() MaterialService.Use2022Materials = Saved.hd end) end
	if Flags.core then pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true) end) end
	if Flags.fov and Saved.fov and Workspace.CurrentCamera then
		pcall(function() Workspace.CurrentCamera.FieldOfView = Saved.fov end)
	end
	if HAS.sethidden then
		if Saved.tech ~= nil then pcall(sethiddenproperty, Lighting, "Technology", Saved.tech) end
		local t = Workspace:FindFirstChildOfClass("Terrain")
		if t and Flags.deco then pcall(sethiddenproperty, t, "Decoration", Saved.deco == nil and true or Saved.deco) end
	end

	pcall(function() gui:Destroy() end)
	env.XG_GFX = nil
end
