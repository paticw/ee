-- BACKGROUND LOOPS
------------------------------------------------------------------------
connect(Workspace.DescendantAdded, enqueue)
connect(Lighting.DescendantAdded, enqueue)

do
	local acc = 0
	connect(RunService.Heartbeat, function(dt)
		local budget = 150
		while qHead <= qTail and budget > 0 do
			local inst = Queue[qHead]
			Queue[qHead] = nil
			qHead = qHead + 1
			if inst and inst.Parent then pcall(processInstance, inst) end
			budget = budget - 1
		end
		if qHead > qTail then qHead, qTail = 1, 0 end

		acc = acc + dt
		if acc >= 0.4 then
			acc = 0
			applyGlobal() -- re-asserts lighting if the game keeps changing it
		end
	end)
end

