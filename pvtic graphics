	round(track, 3)
	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0,
	}, track)
	round(fill, 3)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, fill)
	round(knob, 6)
	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 22), BackgroundTransparency = 1, Text = "", ZIndex = 2,
	}, row)

	local page = self
	local function render(v)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.new(math.clamp(a, 0, 1), 0, 1, 0)
		valLabel.Text = fmt and fmt(v) or tostring(v)
	end
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + a * (max - min)
		v = math.floor(v / step + 0.5) * step
		v = math.clamp(tonumber(string.format("%.4f", v)), min, max)
		if v ~= S[key] then
			S[key] = v
			render(v)
			changed(key)
			if onSet then onSet(v) end
		end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			page.Frame.ScrollingEnabled = false
			activeSlider = {
				drag = setFromX,
				stop = function() page.Frame.ScrollingEnabled = true end,
			}
			setFromX(input.Position.X)
		end
	end)
	Controls[key] = { Set = render }
	render(S[key])
end

function Page:Select(text, options, key, onPick, collapsible)
	local box = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.row,
		BorderSizePixel = 0, LayoutOrder = self:_next(),
	}, self.Frame)
	round(box, 6)
	padding(box, 10, 8, 10, 8)
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, box)

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = 1,
	}, box)
	new("TextLabel", {
		Size = UDim2.new(0.55, 0, 1, 0), BackgroundTransparency = 1, Text = text, Font = FONT, TextSize = 13,
		TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
	}, head)
	local valueLabel = new("TextLabel", {
		Size = UDim2.new(0.45, 0, 1, 0), Position = UDim2.fromScale(0.55, 0), BackgroundTransparency = 1, Text = "",
		Font = FONT, TextSize = 12, TextColor3 = C.accent, TextXAlignment = Enum.TextXAlignment.Right,
	}, head)

	local chipBox = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		LayoutOrder = 2, Visible = not collapsible,
	}, box)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, chipBox)

	local chips = {}
	local open = not collapsible
	local function render(v)
		for name, b in pairs(chips) do
			local sel = (name == v)
			b.BackgroundColor3 = sel and C.accent or C.off
			b.TextColor3 = sel and Color3.new(1, 1, 1) or C.text
		end
		local suffix = ""
		if collapsible then suffix = open and "  [-]" or "  [+]" end
		valueLabel.Text = tostring(v) .. suffix
	end

	for i, opt in ipairs(options) do
		local b = new("TextButton", {
			Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = C.off, Text = opt,
			Font = FONT, TextSize = 12, TextColor3 = C.text, AutoButtonColor = false, LayoutOrder = i,
		}, chipBox)
		round(b, 5)
		padding(b, 10, 0, 10, 0)
		chips[opt] = b
		b.MouseButton1Click:Connect(function()
			if onPick then
				onPick(opt)
			else
				S[key] = opt
				render(opt)
				changed(key)
			end
		end)
	end
	if collapsible then
		head.MouseButton1Click:Connect(function()
			open = not open
			chipBox.Visible = open
			render(S[key])
		end)
	end
	Controls[key] = { Set = render }
	render(S[key])
end

