-- performance monitor
do
	local dts, di = {}, 0
	local frames, acc2 = 0, 0
	local history = {}
	for i = 1, 40 do history[i] = 0 end

	connect(RunService.RenderStepped, function(dt)
		di = di % 120 + 1
		dts[di] = dt
		frames = frames + 1
		acc2 = acc2 + dt
		if acc2 < 0.25 then return end

		local fps = frames / acc2
		frames, acc2 = 0, 0

		local n, sum = #dts, 0
		for i = 1, n do sum = sum + dts[i] end
		local avgFps = n / math.max(sum, 0.0001)
		local sorted = {}
		for i = 1, n do sorted[i] = dts[i] end
		table.sort(sorted)
		local low = 1 / math.max(sorted[math.max(1, math.ceil(n * 0.99))], 0.0001)

		fpsLabel.Text = tostring(math.floor(fps + 0.5)) .. " FPS"
		statLabels.fps.Text = tostring(math.floor(fps + 0.5))
		statLabels.avg.Text = tostring(math.floor(avgFps + 0.5))
		statLabels.low.Text = tostring(math.floor(low + 0.5))
		statLabels.ms.Text = string.format("%.1f ms", 1000 / math.max(fps, 1))

		local okM, mem = pcall(function() return StatsService:GetTotalMemoryUsageMb() end)
		statLabels.mem.Text = okM and (tostring(math.floor(mem)) .. " MB") or "n/a"
		local okP, ping = pcall(function() return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
		statLabels.ping.Text = okP and (tostring(math.floor(ping)) .. " ms") or "n/a"

		table.remove(history, 1)
		history[#history + 1] = fps
		if pages.Dashboard.Frame.Visible then
			updateGraph(history, math.max(avgFps, 30))
		end
	end)
end

