local function applyShaderPreset(name)
	if name == "Off" then
		S.sh_on = false
		S.sh_preset = "Off"
	else
		local p = SHADER_PRESETS[name]
		if not p then return end
		for k, v in pairs(SHADER_BASE) do S[k] = v end
		for k, v in pairs(p) do S[k] = v end
		S.sh_on = true
		S.sh_preset = name
	end
	syncUI(keyList(DEFAULTS))
	fullApply()
end

local function applyLowPreset(name)
	local p = LOW_PRESETS[name]
	if not p then return end
	for _, k in ipairs(LOW_KEYS) do S[k] = p[k] == true end
	S.low_preset = name
	syncUI(LOW_KEYS)
	syncUI({ "low_preset" })
	fullApply()
end

local function applyPack(name)
	if name == "Off" then
		S.tex_on = false
		S.tex_pack = "Off"
	else
		local p = Packs[name]
		if not p then return end
		S.tex_pack = name
		S.tex_on = true
		S.tex_mat_floor, S.tex_mat_wall, S.tex_mat_part = p.Floor[1], p.Wall[1], p.Part[1]
	end
	syncUI({ "tex_on", "tex_pack", "tex_mat_floor", "tex_mat_wall", "tex_mat_part" })
	fullApply()
end

local function applyStyleValues(name)
	local st = Styles[name]
	if not st then return end
	S.refl_style = name
	S.refl_gloss, S.refl_dark, S.refl_strength = st.gloss, st.dark, st.strength
end

local function applyProfile(name)
	local p = PROFILES[name]
	if not p then return end
	for k, v in pairs(DEFAULTS) do
		if not KEEP[k] then S[k] = v end
	end
	if p.shader then
		for k, v in pairs(SHADER_BASE) do S[k] = v end
		for k, v in pairs(SHADER_PRESETS[p.shader]) do S[k] = v end
		S.sh_on = true
		S.sh_preset = p.shader
	end
	if p.low then
		local lp = LOW_PRESETS[p.low]
		for _, k in ipairs(LOW_KEYS) do S[k] = lp[k] == true end
		S.low_preset = p.low
	end
	if p.style then applyStyleValues(p.style) end
	for k, v in pairs(p.set or {}) do S[k] = v end
	syncUI(keyList(DEFAULTS))
	fullApply()
	setStatus("Profile applied: " .. name)
end

local function resetAll()
	for k, v in pairs(DEFAULTS) do
		if not KEEP[k] then S[k] = v end
	end
	syncUI(keyList(DEFAULTS))
	fullApply()
	setStatus("Everything reset to default.")
end

local function setTheme(name)
	local col = THEMES[name]
	if not col then return end
	S.theme = name
	C.accent = col
	for _, r in ipairs(accentRefs) do
		if r[1].Parent then r[1][r[2]] = col end
	end
	setTitle()
	syncUI(keyList(DEFAULTS))
	if currentTab then selectTab(currentTab) end
end

local AUTOFILE = "XG_Graphics_autoload.txt"
local function cfgFile() return "XG_Graphics_" .. S.cfg_slot .. ".json" end

local function saveConfig()
	if not HAS.files then setStatus("Your executor has no file functions.") return end
	local ok = pcall(function() writefile(cfgFile(), HttpService:JSONEncode(S)) end)
	setStatus(ok and ("Saved to slot " .. S.cfg_slot) or "Failed to save config.")
end

local function loadConfig(silent)
	if not HAS.files then
		if not silent then setStatus("Your executor has no file functions.") end
		return
	end
	local ok, data = pcall(function()
		if not isfile(cfgFile()) then return nil end
		return HttpService:JSONDecode(readfile(cfgFile()))
	end)
	if not ok or type(data) ~= "table" then
		if not silent then setStatus("No saved config in slot " .. S.cfg_slot) end
		return
	end
	for k, v in pairs(data) do
		if DEFAULTS[k] ~= nil and type(v) == type(DEFAULTS[k]) then S[k] = v end
	end
	uiScaleObj.Scale = baseScale * S.ui_scale
	setTheme(S.theme)
	Core.applyFps()
	fullApply()
	setStatus("Loaded slot " .. S.cfg_slot)
end

