------------------------------------------------------------------------
-- CORE: reversible property store
------------------------------------------------------------------------
local function cond(c, v)
	if c then return v end
	return nil
end

-- Orig[inst][prop] = value the game had before we touched it.
local Orig = setmetatable({}, { __mode = "k" })
local Removed = {}                                  -- SurfaceAppearances we detached: inst -> parent
local CustomTex = setmetatable({}, { __mode = "k" }) -- part -> { face -> Texture }
local Effects = {}                                  -- our own PostEffects / Atmosphere
local Flags = { render = false, quality = false, future = false, deco = false, hd = false }
local QualityOrig, TechOrig, DecoOrig, HdOrig

-- want == nil  -> restore the original value (if we changed it)
-- want ~= nil  -> force this value
local function put(inst, prop, want)
	local o = Orig[inst]
	if want == nil then
		if o and o[prop] ~= nil then
			local ov = o[prop]
			o[prop] = nil
			if inst[prop] ~= ov then inst[prop] = ov end
		end
		return
	end
	if not o then
		o = {}
		Orig[inst] = o
	end
	if o[prop] == nil then o[prop] = inst[prop] end
	if inst[prop] ~= want then inst[prop] = want end
end

local MAT_CACHE = {}
local function getMat(name)
	if not name or name == "Original" then return nil end
	local m = MAT_CACHE[name]
	if m == nil then
		local ok, v = pcall(function() return Enum.Material[name] end)
		m = (ok and v) or false
		MAT_CACHE[name] = m
	end
	return m or nil
end

local function normalizeId(s)
	s = (tostring(s or ""):gsub("%s+", ""))
	if s == "" then return "" end
	if s:match("^%d+$") then return "rbxassetid://" .. s end
	return s
end

