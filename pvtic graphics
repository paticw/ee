local function Destroy()
	if Dead then return end
	Dead = true
	for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end

	-- give everything back to the game
	for inst, props in pairs(Orig) do
		for prop, ov in pairs(props) do
			pcall(function() inst[prop] = ov end)
		end
	end
	for inst, parent in pairs(Removed) do
		pcall(function() inst.Parent = parent end)
	end
	for _, list in pairs(CustomTex) do
		for _, t in pairs(list) do pcall(function() t:Destroy() end) end
	end
	for _, e in pairs(Effects) do pcall(function() e:Destroy() end) end

	pcall(function() RunService:Set3dRenderingEnabled(true) end)
	if QualityOrig ~= nil then
		pcall(function() settings().Rendering.QualityLevel = QualityOrig end)
	end
	if HAS.sethidden then
		if TechOrig ~= nil then pcall(sethiddenproperty, Lighting, "Technology", TechOrig) end
		local t = Workspace:FindFirstChildOfClass("Terrain")
		if t and Flags.deco then pcall(sethiddenproperty, t, "Decoration", DecoOrig == nil and true or DecoOrig) end
	end
	if HdOrig ~= nil then
		pcall(function() MaterialService.Use2022Materials = HdOrig end)
	end

	pcall(function() gui:Destroy() end)
	env.XG_GFX = nil
end
btnClose.MouseButton1Click:Connect(Destroy)

connect(UserInputService.InputBegan, function(input, processed)
	if processed then return end
	if input.KeyCode.Name == S.ui_key then
		main.Visible = not main.Visible
	end
end)

do
	local frames, t0 = 0, os.clock()
	connect(RunService.RenderStepped, function()
		frames = frames + 1
		local now = os.clock()
		if now - t0 >= 0.5 then
			fpsLabel.Text = tostring(math.floor(frames / (now - t0) + 0.5)) .. " FPS"
			frames, t0 = 0, now
		end
	end)
end

