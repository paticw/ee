-- bar graph; returns update(values, reference)
function Page:Graph(n, height)
	local box = new("Frame", {
		Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = C.row, BorderSizePixel = 0, LayoutOrder = self:_next(),
	}, self.Frame)
	round(box, 7)
	local inner = new("Frame", {
		Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), BackgroundTransparency = 1,
	}, box)
	local bars = {}
	for i = 1, n do
		bars[i] = new("Frame", {
			AnchorPoint = Vector2.new(0, 1), Position = UDim2.new((i - 1) / n, 0, 1, 0), Size = UDim2.new(1 / n, -2, 0.04, 0),
			BackgroundColor3 = C.accent, BorderSizePixel = 0,
		}, inner)
		round(bars[i], 2)
	end
	return function(values, ref)
		local top = math.max(ref * 1.25, 1)
		for i = 1, n do
			local v = values[i] or 0
			bars[i].Size = UDim2.new(1 / n, -2, math.clamp(v / top, 0.04, 1), 0)
			if v >= ref * 0.75 then
				bars[i].BackgroundColor3 = C.accent
			elseif v >= ref * 0.5 then
				bars[i].BackgroundColor3 = C.warn
			else
				bars[i].BackgroundColor3 = C.danger
			end
		end
	end
end

