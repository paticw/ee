		Font = FONT, TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local valLabel = new("TextLabel", {
		Size = UDim2.new(0.35, -12, 0, 22), Position = UDim2.new(0.65, 0, 0, 4), BackgroundTransparency = 1, Text = "",
		Font = FONT_B, TextSize = 12, TextColor3 = C.accent, TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
	acc(valLabel, "TextColor3")
	local track = new("Frame", {
		Size = UDim2.new(1, -24, 0, 6), Position = UDim2.fromOffset(12, 35), BackgroundColor3 = C.off, BorderSizePixel = 0,
	}, row)
	round(track, 3)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0 }, track)
	acc(fill, "BackgroundColor3")
	round(fill, 3)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, fill)
	round(knob, 6)
	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 22), BackgroundTransparency = 1, Text = "", ZIndex = 2,
	}, row)

	local page = self
	local function render(v)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.new(math.clamp(a, 0, 1), 0, 1, 0)
		valLabel.Text = fmt and fmt(v) or tostring(v)
	end
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + a * (max - min)
		v = math.floor(v / step + 0.5) * step
		v = math.clamp(tonumber(string.format("%.4f", v)), min, max)
		if v ~= S[key] then
			S[key] = v
			render(v)
			changed(key)
			if onSet then onSet(v) end
		end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			page.Frame.ScrollingEnabled = false
			activeSlider = { drag = setFromX, stop = function() page.Frame.ScrollingEnabled = true end }
			setFromX(input.Position.X)
		end
	end)
	Controls[key] = { Set = render }
	render(S[key])
end

