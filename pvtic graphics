local function selectTab(name)
	for n, p in pairs(pages) do p.Frame.Visible = (n == name) end
	for n, b in pairs(tabButtons) do
		local sel = (n == name)
		b.BackgroundColor3 = sel and C.accent or C.row
		b.TextColor3 = sel and Color3.new(1, 1, 1) or C.sub
	end
end

local tabOrder = 0
local function newPage(name)
	local scroller = new("ScrollingFrame", {
		Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = C.accent, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
	}, content)
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroller)
	padding(scroller, 2, 2, 8, 8)

	tabOrder = tabOrder + 1
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.row, Text = name, Font = FONT, TextSize = 13,
		TextColor3 = C.sub, AutoButtonColor = false, LayoutOrder = tabOrder,
	}, sidebar)
	round(b, 6)
	b.MouseButton1Click:Connect(function() selectTab(name) end)

	local page = setmetatable({ Frame = scroller, order = 0 }, Page)
	pages[name] = page
	tabButtons[name] = b
	return page
end

