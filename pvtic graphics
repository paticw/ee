local Controls = {}
local function syncUI(keys)
	for _, k in ipairs(keys) do
		local c = Controls[k]
		if c then c.Set(S[k]) end
	end
end

local function keyList(set)
	local t = {}
	for k in pairs(set) do t[#t + 1] = k end
	return t
end

local INST_KEYS = {}
for _, k in ipairs({
	"noshadows", "notextures", "smooth", "noparticles", "nopostfx", "lowmesh", "noreflect",
	"sh_on", "surf_reflect",
	"tex_on", "tex_pack", "tex_floor", "tex_wall", "tex_part",
	"tex_mat_floor", "tex_mat_wall", "tex_mat_part", "tex_usecolors", "tex_minsize",
	"tex_custom_on", "tex_custom_id", "tex_custom_size",
}) do INST_KEYS[k] = true end

local function changed(key)
	if SHADER_KEYS[key] then
		if key == "sh_on" then
			if S.sh_on then
				if S.sh_preset == "Off" then S.sh_preset = "Custom" end
			else
				S.sh_preset = "Off"
			end
			syncUI({ "sh_preset" })
		elseif S.sh_preset ~= "Custom" and S.sh_preset ~= "Off" then
			S.sh_preset = "Custom"
			syncUI({ "sh_preset" })
		end
	end
	if LOW_SET[key] and S.low_preset ~= "Custom" then
		S.low_preset = "Custom"
		syncUI({ "low_preset" })
	end
	if key == "tex_on" then
		if S.tex_on and S.tex_pack == "Off" then
			S.tex_pack = "Custom"
		elseif not S.tex_on then
			S.tex_pack = "Off"
		end
		syncUI({ "tex_pack" })
	end
	pcall(applyGlobal)
	if INST_KEYS[key] then scheduleRefresh(0.15) end
end

local function applyShaderPreset(name)
	if name == "Off" then
		S.sh_on = false
		S.sh_preset = "Off"
	else
		local p = SHADER_PRESETS[name]
		if not p then return end
		for k, v in pairs(SHADER_BASE) do S[k] = v end
		for k, v in pairs(p) do S[k] = v end
		S.sh_on = true
		S.sh_preset = name
	end
	syncUI(keyList(SHADER_KEYS))
	syncUI({ "sh_preset" })
	fullApply()
end

local function applyLowPreset(name)
	local p = LOW_PRESETS[name]
	if not p then return end
	for _, k in ipairs(LOW_KEYS) do S[k] = p[k] == true end
	S.low_preset = name
	syncUI(LOW_KEYS)
	syncUI({ "low_preset" })
	fullApply()
end

local function applyPack(name)
	if name == "Off" then
		S.tex_on = false
		S.tex_pack = "Off"
	else
		local p = Packs[name]
		if not p then return end
		S.tex_pack = name
		S.tex_on = true
		S.tex_mat_floor, S.tex_mat_wall, S.tex_mat_part = p.Floor[1], p.Wall[1], p.Part[1]
	end
	syncUI({ "tex_on", "tex_pack", "tex_mat_floor", "tex_mat_wall", "tex_mat_part" })
	fullApply()
end

