local function applyFps()
	if not HAS.setfpscap then return end
	pcall(setfpscap, S.fpscap_on and S.fpscap or 60)
end

local function saveConfig()
	if not HAS.files then setStatus("Your executor has no file functions.") return end
	local ok = pcall(function() writefile(CFG_FILE, HttpService:JSONEncode(S)) end)
	setStatus(ok and ("Saved to " .. CFG_FILE) or "Failed to save config.")
end

local function loadConfig()
	if not HAS.files then setStatus("Your executor has no file functions.") return end
	local ok, data = pcall(function()
		if not isfile(CFG_FILE) then return nil end
		return HttpService:JSONDecode(readfile(CFG_FILE))
	end)
	if not ok or type(data) ~= "table" then setStatus("No saved config found.") return end
	for k, v in pairs(data) do
		if DEFAULTS[k] ~= nil and type(v) == type(DEFAULTS[k]) then S[k] = v end
	end
	syncUI(keyList(DEFAULTS))
	applyFps()
	fullApply()
	setStatus("Config loaded.")
end

local function resetAll()
	for k, v in pairs(DEFAULTS) do S[k] = v end
	syncUI(keyList(DEFAULTS))
	fullApply()
	setStatus("Everything reset to default.")
end

