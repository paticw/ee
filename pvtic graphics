------------------------------------------------------------------------
-- HELPERS
------------------------------------------------------------------------
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function round(o, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end
local function padding(o, l, t, r, b)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b),
	}, o)
end
local function cond(c, v)
	if c then return v end
	return nil
end
local function mountGui(g)
	if type(syn) == "table" and syn.protect_gui then pcall(syn.protect_gui, g) end
	local ok = false
	if HAS.gethui then ok = pcall(function() g.Parent = gethui() end) end
	if not ok or not g.Parent then ok = pcall(function() g.Parent = CoreGui end) end
	if not ok or not g.Parent then g.Parent = LocalPlayer:WaitForChild("PlayerGui") end
end

------------------------------------------------------------------------
-- CORE STATE: reversible property store
------------------------------------------------------------------------
local Core = { kick = false }
local Orig = setmetatable({}, { __mode = "k" })         -- inst -> { prop = original value }
local Own = setmetatable({}, { __mode = "k" })          -- instances created by this script
local Removed = {}                                      -- detached SurfaceAppearances: inst -> parent
local CustomTex = setmetatable({}, { __mode = "k" })    -- part -> { face -> Texture }
local GlossySet = {}                                    -- floors currently made glossy
local Effects = {}                                      -- our PostEffects / Atmosphere
local Flags = { render = false, quality = nil, future = false, deco = false, hd = false, mesh = false, core = false, fov = false }
local Saved = {}                                        -- original engine values

-- want == nil -> restore the original (if we changed it); otherwise force the value
local function put(inst, prop, want)
	local o = Orig[inst]
	if want == nil then
		if o and o[prop] ~= nil then
			local ov = o[prop]
			o[prop] = nil
			if inst[prop] ~= ov then inst[prop] = ov end
		end
		return
	end
	if not o then
		o = {}
		Orig[inst] = o
	end
	if o[prop] == nil then o[prop] = inst[prop] end
	if inst[prop] ~= want then inst[prop] = want end
end

local MAT_CACHE = {}
local function getMat(name)
	if not name or name == "Original" then return nil end
	local m = MAT_CACHE[name]
	if m == nil then
		local ok, v = pcall(function() return Enum.Material[name] end)
		m = (ok and v) or false
		MAT_CACHE[name] = m
	end
	return m or nil
end

local function normalizeId(s)
	s = (tostring(s or ""):gsub("%s+", ""))
	if s == "" then return "" end
	if s:match("^%d+$") then return "rbxassetid://" .. s end
	return s
end

------------------------------------------------------------------------
-- CORE: world scan (parts, textures, particles, lights ...)
------------------------------------------------------------------------
do
	local Plan, CustomCats = {}, {}
	local planActive, customActive = false, false
	local CustomId = ""
	local customCount = 0
	local ModelCache = setmetatable({}, { __mode = "k" })
	local FACES = Enum.NormalId:GetEnumItems()
	local PERF, PRECISE = Enum.RenderFidelity.Performance, Enum.RenderFidelity.Precise
	local SMOOTH = Enum.Material.SmoothPlastic
	local M_NEON, M_GLASS, M_FF = Enum.Material.Neon, Enum.Material.Glass, Enum.Material.ForceField
	local jobId, CHUNK = 0, 400
	local refreshToken = 0
	local Queue, qHead, qTail = {}, 1, 0

	local function buildPlan()
		Plan, CustomCats = {}, {}
		planActive, customActive = false, false
		CustomId = normalizeId(S.tex_custom_id)
		local pack = Packs[S.tex_pack]
		for _, cat in ipairs({ "Floor", "Wall", "Part" }) do
			local lc = cat:lower()
			if S["tex_" .. lc] then
				if S.tex_on then
					local entry = pack and pack[cat]
					Plan[cat] = {
						mat = getMat(S["tex_mat_" .. lc]),
						color = (entry and S.tex_usecolors) and entry[2] or nil,
						refl = entry and entry[3] or nil,
					}
					planActive = true
				end
				if S.tex_custom_on and CustomId ~= "" then
					CustomCats[cat] = true
					customActive = true
				end
			end
		end
	end

	local function nextModel(inst)
		local p = inst.Parent
		while p and p ~= Workspace do
			if p:IsA("Model") then return p end
			p = p.Parent
		end
		return nil
	end

	-- true if the instance belongs to a character / NPC (a model with a Humanoid)
	local function inCharacter(inst)
		local m = nextModel(inst)
		while m do
			local c = ModelCache[m]
			if c == nil then
				c = m:FindFirstChildOfClass("Humanoid") ~= nil
				ModelCache[m] = c
			end
			if c then return true end
			m = nextModel(m)
		end
		return false
	end

	-- Floor = thin horizontal slab, Wall = thin vertical slab, Part = everything else
	local function classify(p)
		local s, cf = p.Size, p.CFrame
		local x, y, z = s.X, s.Y, s.Z
		local thin, axis
		if x <= y and x <= z then
			thin, axis = x, cf.RightVector
		elseif y <= x and y <= z then
			thin, axis = y, cf.UpVector
		else
			thin, axis = z, cf.LookVector
		end
		local big = math.max(x, y, z)
		local mid = x + y + z - thin - big
		if thin <= mid * 0.6 and big >= 3 then
			if math.abs(axis.Y) > 0.7 then return "Floor", big end
			return "Wall", big
		end
		return "Part", big
	end

	local function vary(c, p)
		local v = S.tex_vary
		if v <= 0 or not p.Anchored then return c end
		local pos = p.Position
		local h = (math.sin(pos.X * 12.9898 + pos.Z * 78.233 + pos.Y * 37.719) * 43758.5453) % 1
		local m = 1 + (h - 0.5) * 2 * v
		return Color3.new(math.clamp(c.R * m, 0, 1), math.clamp(c.G * m, 0, 1), math.clamp(c.B * m, 0, 1))
	end

	local function syncCustom(p, want, cat)
		local list = CustomTex[p]
		if want then
			if not list then
				if customCount >= 3000 then return end
				list = {}
				CustomTex[p] = list
				customCount = customCount + 1
			end
			local faces = (cat == "Floor") and { Enum.NormalId.Top } or FACES
			for _, face in ipairs(faces) do
				local t = list[face]
				if not t or not t.Parent then
					t = Instance.new("Texture")
					t.Name = "XG_Tex"
					t.Face = face
					Own[t] = true
					t.Parent = p
					list[face] = t
				end
				if t.Texture ~= CustomId then t.Texture = CustomId end
				local tile = S.tex_custom_size
				if t.StudsPerTileU ~= tile then t.StudsPerTileU = tile end
				if t.StudsPerTileV ~= tile then t.StudsPerTileV = tile end
			end
		elseif list then
			for _, t in pairs(list) do
				pcall(function() t:Destroy() end)
			end
			CustomTex[p] = nil
			customCount = math.max(0, customCount - 1)
		end
	end

	local function processPart(p)
		if Own[p] then return end

		-- glossy floors (decided by the reflection scanner)
		local glossy = GlossySet[p]
		local gMat, gCol, gRefl, gTr
		if glossy then gMat, gCol, gRefl, gTr = Core.floorLook(p) end
		put(p, "Transparency", gTr)
		put(p, "CastShadow", cond(S.noshadows or (glossy and S.refl_scene), false))
		if glossy then
			put(p, "Material", gMat)
			put(p, "Color", gCol)
			put(p, "Reflectance", gRefl)
			if CustomTex[p] then syncCustom(p, false) end
			return
		end

		local transparent = p.Transparency > 0.3
		local cat, plan, custom
		if (planActive or customActive) and not transparent and not inCharacter(p) then
			local c, big = classify(p)
			if c ~= "Part" or big >= S.tex_minsize then
				-- never re-skin glowing / glass parts
				local om = (Orig[p] and Orig[p].Material) or p.Material
				if om ~= M_NEON and om ~= M_GLASS and om ~= M_FF then
					cat = c
					plan = Plan[c]
					custom = CustomCats[c]
				end
			end
		end

		local mat, col, refl
		if plan then
			mat, col, refl = plan.mat, plan.color, plan.refl
			if col then col = vary(col, p) end
		end
		if not mat and S.smooth then mat = SMOOTH end
		if S.noreflect then
			refl = 0
		elseif not refl and S.sh_on and S.surf_reflect > 0 and p.Transparency < 0.5 then
			refl = S.surf_reflect
		end

		put(p, "Material", mat)
		put(p, "Color", col)
		put(p, "Reflectance", refl)

		if p:IsA("MeshPart") then
			put(p, "TextureID", cond(S.notextures, ""))
			local fid
			if S.lowmesh then fid = PERF elseif S.gpu_precise then fid = PRECISE end
			pcall(put, p, "RenderFidelity", fid)
		end

		if custom or CustomTex[p] then
			syncCustom(p, custom and true or false, cat)
		end
	end

	local function processInstance(inst)
		if inst:IsA("BasePart") then
			if inst:IsA("Terrain") then return end
			processPart(inst)
		elseif inst:IsA("Decal") then -- Texture inherits Decal
			if not Own[inst] then
				put(inst, "Transparency", cond(S.notextures, 1))
			end
		elseif inst:IsA("SurfaceAppearance") then
			if S.notextures and inst.Parent then
				Removed[inst] = inst.Parent
				inst.Parent = nil
			end
		elseif inst:IsA("PostEffect") then
			if not Own[inst] then
				put(inst, "Enabled", cond(S.nopostfx, false))
			end
		elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
			or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
			if not Own[inst] then
				put(inst, "Enabled", cond(S.noparticles, false))
			end
		elseif inst:IsA("Explosion") then
			put(inst, "Visible", cond(S.noparticles, false))
		elseif inst:IsA("Light") then
			if not Own[inst] then
				local want
				if S.noshadows then want = false elseif S.gpu_lightshadows then want = true end
				put(inst, "Shadows", want)
			end
		end
	end

	local function refreshAll()
		jobId = jobId + 1
		local my = jobId
		buildPlan()
		ModelCache = setmetatable({}, { __mode = "k" })
		customCount = 0
		for _ in pairs(CustomTex) do customCount = customCount + 1 end

		-- bring back detached SurfaceAppearances when "No Textures" is off
		if not S.notextures then
			for inst, parent in pairs(Removed) do
				Removed[inst] = nil
				pcall(function() if parent and parent.Parent then inst.Parent = parent end end)
			end
		end

		local list = Workspace:GetDescendants()
		local extra = Lighting:GetDescendants()
		for i = 1, #extra do list[#list + 1] = extra[i] end

		local n = 0
		for i = 1, #list do
			if my ~= jobId or Dead then return end
			local inst = list[i]
			if inst.Parent then pcall(processInstance, inst) end
			n = n + 1
			if n >= CHUNK then
				n = 0
				task.wait()
			end
		end
	end

	function Core.scheduleRefresh(delay)
		refreshToken = refreshToken + 1
		local t = refreshToken
		task.delay(delay or 0.15, function()
			if t == refreshToken and not Dead then refreshAll() end
		end)
	end

	local function needsWatch()
		return S.noshadows or S.notextures or S.smooth or S.noparticles or S.nopostfx
			or S.lowmesh or S.noreflect or S.tex_on or S.tex_custom_on or S.gpu_precise
			or S.gpu_lightshadows or (S.sh_on and S.surf_reflect > 0)
	end

	function Core.enqueue(inst)
		if needsWatch() then
			qTail = qTail + 1
			Queue[qTail] = inst
		end
	end

	function Core.drainQueue(budget)
		while qHead <= qTail and budget > 0 do
			local inst = Queue[qHead]
			Queue[qHead] = nil
			qHead = qHead + 1
			if inst and inst.Parent then pcall(processInstance, inst) end
			budget = budget - 1
		end
		if qHead > qTail then qHead, qTail = 1, 0 end
	end

	Core.processInstance = processInstance
	Core.inCharacter = inCharacter
	Core.classify = classify
	Core.refreshAll = refreshAll
	Core.restoreCustomTex = function()
		for _, list in pairs(CustomTex) do
			for _, t in pairs(list) do pcall(function() t:Destroy() end) end
		end
	end
end

------------------------------------------------------------------------
-- CORE: global state (lighting, post-fx, atmosphere, terrain, engine)
------------------------------------------------------------------------
do
	local LIGHT_PROPS = {
		"ClockTime", "Brightness", "GlobalShadows", "Ambient", "OutdoorAmbient", "FogEnd", "FogStart",
		"ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
		"GeographicLatitude", "ColorShift_Top", "ColorShift_Bottom", "ShadowSoftness",
	}
	local WATER_PROPS = { "WaterTransparency", "WaterReflectance", "WaterWaveSize", "WaterWaveSpeed" }
	local ATMO_PROPS = { "Density", "Offset", "Haze", "Glare", "Color", "Decay" }
	local AF = { cur = 80, target = 80, t = 0, params = RaycastParams.new() }
	local MB = { cur = 0, prev = nil }

	local function tintFromWarmth(w)
		w = math.clamp(w, -1, 1)
		local white = Color3.new(1, 1, 1)
		if w >= 0 then return white:Lerp(Color3.fromRGB(255, 205, 150), w) end
		return white:Lerp(Color3.fromRGB(150, 195, 255), -w)
	end

	local function atmoColor(w)
		w = math.clamp(w, -1, 1)
		local base = Color3.fromRGB(198, 202, 210)
		if w >= 0 then return base:Lerp(Color3.fromRGB(255, 172, 104), w) end
		return base:Lerp(Color3.fromRGB(120, 165, 235), -w)
	end

	local function shiftColor(w)
		w = math.clamp(w, -1, 1) * 0.55
		local black = Color3.new(0, 0, 0)
		if w >= 0 then return black:Lerp(Color3.fromRGB(255, 190, 120), w) end
		return black:Lerp(Color3.fromRGB(110, 150, 255), -w)
	end

	local function ensureEffect(class, name)
		local e = Effects[name]
		if e and e.Parent == Lighting then return e end
		if e then pcall(function() e:Destroy() end) end
		e = Instance.new(class)
		e.Name = name
		e.Enabled = false
		Own[e] = true
		e.Parent = Lighting
		Effects[name] = e
		return e
	end

	local function setProps(o, t)
		for k, v in pairs(t) do
			if o[k] ~= v then o[k] = v end
		end
	end

	local function effectOff(name)
		local e = Effects[name]
		if e and e.Enabled then e.Enabled = false end
	end

	function Core.applyLighting()
		local d = {}
		if S.sh_on then
			if S.tm_on then
				d.ClockTime = S.clock
				d.GeographicLatitude = S.sun_lat
			end
			d.Brightness = S.bright
			d.ExposureCompensation = S.exposure
			d.EnvironmentDiffuseScale = S.envdiff
			d.EnvironmentSpecularScale = S.envspec
			if S.shift_top ~= 0 then d.ColorShift_Top = shiftColor(S.shift_top) end
			if S.shift_bot ~= 0 then d.ColorShift_Bottom = shiftColor(S.shift_bot) end
		end
		if S.gpu_shadow_on then d.ShadowSoftness = S.gpu_shadow end
		if S.fullbright then
			d.Brightness = 2
			d.ClockTime = 14
			d.GlobalShadows = false
			d.Ambient = Color3.new(1, 1, 1)
			d.OutdoorAmbient = Color3.new(1, 1, 1)
		end
		if S.noshadows then d.GlobalShadows = false end
		if S.nofog then
			d.FogStart = 0
			d.FogEnd = 9e9
		end
		if S.noreflect then d.EnvironmentSpecularScale = 0 end

		for _, prop in ipairs(LIGHT_PROPS) do
			pcall(put, Lighting, prop, d[prop])
		end

		-- experimental Future lighting
		if Flags.future ~= S.future then
			Flags.future = S.future
			if HAS.sethidden then
				if S.future then
					if Saved.tech == nil and HAS.gethidden then
						local ok, v = pcall(gethiddenproperty, Lighting, "Technology")
						if ok then Saved.tech = v end
					end
					pcall(sethiddenproperty, Lighting, "Technology", Enum.Technology.Future)
				elseif Saved.tech ~= nil then
					pcall(sethiddenproperty, Lighting, "Technology", Saved.tech)
				end
			end
		end
	end

	function Core.applyEffects()
		local on = S.sh_on

		if on and S.bloom_on then
			setProps(ensureEffect("BloomEffect", "XG_Bloom"), {
				Enabled = true, Intensity = S.bloom_i, Size = S.bloom_s, Threshold = S.bloom_t,
			})
		else
			effectOff("XG_Bloom")
		end

		if on and S.cc_on then
			setProps(ensureEffect("ColorCorrectionEffect", "XG_ColorCorrection"), {
				Enabled = true, Brightness = S.cc_bright, Contrast = S.cc_contrast,
				Saturation = S.cc_sat, TintColor = tintFromWarmth(S.cc_warm),
			})
		else
			effectOff("XG_ColorCorrection")
		end

		if on and S.sun_on then
			setProps(ensureEffect("SunRaysEffect", "XG_SunRays"), {
				Enabled = true, Intensity = S.sun_i, Spread = S.sun_s,
			})
		else
			effectOff("XG_SunRays")
		end

		if on and S.dof_on then
			setProps(ensureEffect("DepthOfFieldEffect", "XG_DepthOfField"), {
				Enabled = true, FarIntensity = S.dof_far,
				FocusDistance = S.dof_auto and AF.cur or S.dof_focus,
				InFocusRadius = S.dof_radius, NearIntensity = S.dof_near,
			})
		else
			effectOff("XG_DepthOfField")
		end
	end

	function Core.applyAtmosphere()
		local want = S.sh_on and S.atmo_on
		local ga
		for _, c in ipairs(Lighting:GetChildren()) do
			if c:IsA("Atmosphere") and not Own[c] then
				ga = c
				break
			end
		end

		local target = ga
		if want and not ga then
			local a = Effects.XG_Atmosphere
			if not a or a.Parent ~= Lighting then
				if a then pcall(function() a:Destroy() end) end
				a = Instance.new("Atmosphere")
				a.Name = "XG_Atmosphere"
				Own[a] = true
				a.Parent = Lighting
				Effects.XG_Atmosphere = a
			end
			target = a
		elseif not want and Effects.XG_Atmosphere then
			pcall(function() Effects.XG_Atmosphere:Destroy() end)
			Effects.XG_Atmosphere = nil
		end
		if not target then return end

		local d = {}
		if want then
			local col = atmoColor(S.cc_warm)
			d.Density, d.Offset, d.Haze, d.Glare = S.atmo_density, S.atmo_offset, S.atmo_haze, S.atmo_glare
			d.Color = col
			d.Decay = col:Lerp(Color3.new(0, 0, 0), 0.55)
		end
		if S.nofog then
			d.Density = 0
			d.Haze = 0
		end
		for _, p in ipairs(ATMO_PROPS) do
			pcall(put, target, p, d[p])
		end
	end

	function Core.applyTerrain()
		local t = Workspace:FindFirstChildOfClass("Terrain")
		if not t then return end

		local d = {}
		if S.sh_on and S.water_on then
			d.WaterTransparency = S.water_transp
			d.WaterReflectance = S.water_reflect
			d.WaterWaveSize = S.water_wave
		end
		if S.nowater then
			d.WaterWaveSize = 0
			d.WaterWaveSpeed = 0
			d.WaterReflectance = 0
		end
		for _, p in ipairs(WATER_PROPS) do
			pcall(put, t, p, d[p])
		end

		local clouds = t:FindFirstChildOfClass("Clouds")
		if clouds then pcall(put, clouds, "Enabled", cond(S.noclouds, false)) end

		if Flags.deco ~= S.noterraindeco then
			Flags.deco = S.noterraindeco
			if HAS.sethidden then
				if S.noterraindeco then
					if Saved.deco == nil and HAS.gethidden then
						local ok, v = pcall(gethiddenproperty, t, "Decoration")
						if ok and v ~= nil then Saved.deco = v else Saved.deco = true end
					end
					pcall(sethiddenproperty, t, "Decoration", false)
				else
					pcall(sethiddenproperty, t, "Decoration", Saved.deco == nil and true or Saved.deco)
				end
			end
		end
	end

	function Core.applyFps()
		if not HAS.setfpscap then return end
		local v = 60
		if S.fpscap_on then
			v = (S.fpscap >= 1000) and 0 or S.fpscap
		end
		pcall(setfpscap, v)
	end

	function Core.applyEngine()
		if Flags.render ~= S.disable3d then
			Flags.render = S.disable3d
			pcall(function() RunService:Set3dRenderingEnabled(not S.disable3d) end)
		end

		local want = (S.lowquality and "low") or (S.gpu_maxq and "max") or false
		if Flags.quality ~= want then
			Flags.quality = want
			if want then
				if Saved.quality == nil then
					pcall(function() Saved.quality = settings().Rendering.QualityLevel end)
				end
				pcall(function()
					settings().Rendering.QualityLevel = (want == "low") and Enum.QualityLevel.Level01 or Enum.QualityLevel.Level21
				end)
			elseif Saved.quality ~= nil then
				pcall(function() settings().Rendering.QualityLevel = Saved.quality end)
			end
		end

		if Flags.mesh ~= S.gpu_precise then
			Flags.mesh = S.gpu_precise
			if S.gpu_precise then
				if Saved.mesh == nil then
					pcall(function() Saved.mesh = settings().Rendering.MeshPartDetailLevel end)
				end
				pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04 end)
			elseif Saved.mesh ~= nil then
				pcall(function() settings().Rendering.MeshPartDetailLevel = Saved.mesh end)
			end
		end

		if Flags.hd ~= S.hdmats then
			Flags.hd = S.hdmats
			if Saved.hd == nil then
				pcall(function() Saved.hd = MaterialService.Use2022Materials end)
			end
			local ok = pcall(function() MaterialService.Use2022Materials = S.hdmats end)
			if not ok and HAS.sethidden then
				pcall(sethiddenproperty, MaterialService, "Use2022Materials", S.hdmats)
			end
		end

		if Flags.core ~= S.hide_core then
			Flags.core = S.hide_core
			pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, not S.hide_core) end)
		end
	end

	------------------------------------------------------------------
	-- per-frame steps (day cycle, FOV, motion blur, auto focus)
	------------------------------------------------------------------
	function Core.cycleStep(dt)
		if not (S.cycle_on and S.sh_on and S.tm_on) or S.fullbright then return end
		S.clock = (S.clock + dt * S.cycle_speed / 60) % 24
		pcall(put, Lighting, "ClockTime", S.clock)
	end

	function Core.cameraStep(dt)
		local cam = Workspace.CurrentCamera
		if not cam then return end

		-- FOV
		if S.fov_on then
			if not Flags.fov then
				Flags.fov = true
				Saved.fov = cam.FieldOfView
			end
			if cam.FieldOfView ~= S.fov then cam.FieldOfView = S.fov end
		elseif Flags.fov then
			Flags.fov = false
			if Saved.fov then cam.FieldOfView = Saved.fov end
		end

		local look = cam.CFrame.LookVector

		-- motion blur: blur strength follows how fast the camera is turning
		if S.mblur_on then
			local prev = MB.prev or look
			local ang = math.acos(math.clamp(look:Dot(prev), -1, 1))
			local speed = ang / math.max(dt, 1 / 240)
			local target = math.clamp((speed - 1) * 5 * S.mblur_i, 0, 22 * S.mblur_i)
			MB.cur = MB.cur + (target - MB.cur) * math.clamp(dt * 14, 0, 1)
			local e = ensureEffect("BlurEffect", "XG_MotionBlur")
			if MB.cur > 0.4 then
				if e.Size ~= MB.cur then e.Size = MB.cur end
				if not e.Enabled then e.Enabled = true end
			elseif e.Enabled then
				e.Enabled = false
			end
		elseif MB.cur ~= 0 or Effects.XG_MotionBlur then
			MB.cur = 0
			effectOff("XG_MotionBlur")
		end
		MB.prev = look

		-- depth-of-field auto focus
		if S.sh_on and S.dof_on and S.dof_auto then
			AF.t = AF.t + dt
			if AF.t >= 0.07 then
				AF.t = 0
				local res = Workspace:Raycast(cam.CFrame.Position, look * 900, AF.params)
				AF.target = res and res.Distance or 900
			end
			AF.cur = AF.cur + (AF.target - AF.cur) * math.clamp(dt * 7, 0, 1)
			local e = Effects.XG_DepthOfField
			if e and e.Parent and e.Enabled then e.FocusDistance = AF.cur end
		end

		if Core.particleFollow then Core.particleFollow(cam) end
	end

	function Core.destroyEffects()
		for _, e in pairs(Effects) do pcall(function() e:Destroy() end) end
		Effects = {}
	end
end

------------------------------------------------------------------------
-- CORE: screen overlays (vignette + cinematic bars)
------------------------------------------------------------------------
do
	local ov
	local lastVig

	local function ensureOverlay()
		if ov and ov.gui.Parent then return ov end
		local g = new("ScreenGui", {
			Name = tostring(math.random(1000000, 9000000)), ResetOnSpawn = false, IgnoreGuiInset = true,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 900,
		})
		mountGui(g)
		local black = Color3.new(0, 0, 0)
		local function band(size, pos, anchor, rot)
			local f = new("Frame", {
				Size = size, Position = pos, AnchorPoint = anchor, BackgroundColor3 = black,
				BorderSizePixel = 0, Visible = false,
			}, g)
			local gr = new("UIGradient", { Rotation = rot }, f)
			return { frame = f, grad = gr }
		end
		ov = {
			gui = g,
			vig = {
				band(UDim2.new(1, 0, 0.26, 0), UDim2.new(0, 0, 0, 0), Vector2.new(0, 0), 90),
				band(UDim2.new(1, 0, 0.26, 0), UDim2.new(0, 0, 1, 0), Vector2.new(0, 1), 270),
				band(UDim2.new(0.2, 0, 1, 0), UDim2.new(0, 0, 0, 0), Vector2.new(0, 0), 0),
				band(UDim2.new(0.2, 0, 1, 0), UDim2.new(1, 0, 0, 0), Vector2.new(1, 0), 180),
			},
			barTop = new("Frame", {
				Size = UDim2.new(1, 0, 0.1, 0), BackgroundColor3 = black, BorderSizePixel = 0, Visible = false,
			}, g),
			barBot = new("Frame", {
				Size = UDim2.new(1, 0, 0.1, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
				BackgroundColor3 = black, BorderSizePixel = 0, Visible = false,
			}, g),
		}
		lastVig = nil
		return ov
	end

	function Core.applyOverlays()
		if not (S.vig_on or S.bars_on) and not ov then return end
		local o = ensureOverlay()

		for _, b in ipairs(o.vig) do
			if b.frame.Visible ~= S.vig_on then b.frame.Visible = S.vig_on end
		end
		if S.vig_on and lastVig ~= S.vig_i then
			lastVig = S.vig_i
			local seq = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1 - math.clamp(S.vig_i, 0, 1)),
				NumberSequenceKeypoint.new(1, 1),
			})
			for _, b in ipairs(o.vig) do b.grad.Transparency = seq end
		end

		o.barTop.Visible = S.bars_on
		o.barBot.Visible = S.bars_on
		local h = UDim2.new(1, 0, S.bars_h, 0)
		if o.barTop.Size ~= h then
			o.barTop.Size = h
			o.barBot.Size = h
		end
	end

	function Core.destroyOverlay()
		if ov then pcall(function() ov.gui:Destroy() end) end
		ov = nil
	end
end

------------------------------------------------------------------------
-- CORE: ambient particles (dust / fireflies / snow) following the camera
------------------------------------------------------------------------
do
	local part, emitter, curMode
	local MODES = {
		Dust = { size = Vector3.new(60, 28, 60), offset = Vector3.new(0, 0, 0), rate = 25 },
		Fireflies = { size = Vector3.new(60, 8, 60), offset = Vector3.new(0, -2, 0), rate = 5 },
		Snow = { size = Vector3.new(90, 1, 90), offset = Vector3.new(0, 45, 0), rate = 90 },
	}
	local SOFT = "rbxasset://textures/particles/smoke_main.dds"
	local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

	local function configure(e, mode)
		if mode == "Dust" then
			e.Texture = SOFT
			e.Lifetime = NumberRange.new(6, 10)
			e.Speed = NumberRange.new(0.2, 0.8)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Size = NumberSequence.new(0.18)
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.78),
				NumberSequenceKeypoint.new(0.8, 0.78), NumberSequenceKeypoint.new(1, 1),
			})
			e.Color = ColorSequence.new(Color3.fromRGB(255, 244, 222))
			e.LightEmission = 0.5
			e.RotSpeed = NumberRange.new(-20, 20)
		elseif mode == "Fireflies" then
			e.Texture = SPARK
			e.Lifetime = NumberRange.new(5, 9)
			e.Speed = NumberRange.new(0.5, 1.5)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Size = NumberSequence.new(0.35)
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0.1),
				NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(0.85, 0.1),
				NumberSequenceKeypoint.new(1, 1),
			})
			e.Color = ColorSequence.new(Color3.fromRGB(190, 255, 110))
			e.LightEmission = 1
		else -- Snow
			e.Texture = SOFT
			e.Lifetime = NumberRange.new(9, 12)
			e.Speed = NumberRange.new(2, 5)
			e.EmissionDirection = Enum.NormalId.Bottom
			e.SpreadAngle = Vector2.new(15, 15)
			e.Acceleration = Vector3.new(0.8, -3, 0.3)
			e.Size = NumberSequence.new(0.22)
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.15),
				NumberSequenceKeypoint.new(0.9, 0.15), NumberSequenceKeypoint.new(1, 1),
			})
			e.Color = ColorSequence.new(Color3.new(1, 1, 1))
			e.LightEmission = 0.3
		end
	end

	local function destroyAll()
		if part then pcall(function() part:Destroy() end) end
		part, emitter, curMode = nil, nil, nil
	end

	function Core.applyParticles()
		local mode = S.part_mode
		local m = MODES[mode]
		if not m then
			if part then destroyAll() end
			return
		end
		if mode ~= curMode or not part or not part.Parent then
			destroyAll()
			part = Instance.new("Part")
			part.Name = "XG"
			part.Transparency = 1
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			part.Size = m.size
			Own[part] = true
			emitter = Instance.new("ParticleEmitter")
			Own[emitter] = true
			configure(emitter, mode)
			emitter.Parent = part
			part.Parent = Workspace
			curMode = mode
		end
		local rate = m.rate * S.part_density
		if emitter.Rate ~= rate then emitter.Rate = rate end
	end

	function Core.particleFollow(cam)
		if part and part.Parent and curMode then
			part.CFrame = CFrame.new(cam.CFrame.Position + MODES[curMode].offset)
		end
	end

	Core.destroyParticles = destroyAll
end

function Core.applyGlobal()
	pcall(Core.applyLighting)
	pcall(Core.applyEffects)
	pcall(Core.applyAtmosphere)
	pcall(Core.applyTerrain)
	pcall(Core.applyEngine)
	pcall(Core.applyOverlays)
	pcall(Core.applyParticles)
end

------------------------------------------------------------------------
-- CORE: reflections (glossy floors + mirrored scene) and neon glow lights
------------------------------------------------------------------------
-- How the scene reflection works:
--   1. A ray under your character finds the floor height (the "mirror plane").
--   2. Flat floor parts at that height become glossy and (optionally)
--      semi-transparent.
--   3. Nearby parts are copied and mirrored through the plane, so you see
--      an upside-down copy of the scene "inside" the glossy floor.
--   4. Moving parts (characters, unanchored objects) are re-mirrored each
--      frame with BulkMoveTo; static parts are refreshed every scan.
do
	local folder
	local clones = {}       -- source part -> mirrored clone
	local staticCF = {}     -- source part -> last source CFrame we mirrored
	local dynSrc, dynDst = {}, {}
	local glow = {}         -- neon part -> PointLight
	local plane
	local accum = 0
	local errCount = 0
	local EXCLUDE = Enum.RaycastFilterType.Exclude
	local ovp = OverlapParams.new()
	local rp = RaycastParams.new()
	ovp.FilterType = EXCLUDE
	rp.FilterType = EXCLUDE
	local M_NEON = Enum.Material.Neon

	local function ensureFolder()
		if folder and folder.Parent then return folder end
		folder = Instance.new("Folder")
		folder.Name = tostring(math.random(100000, 999999))
		folder.Parent = Workspace
		return folder
	end

	-- reflect a CFrame through the horizontal plane y = plane.
	-- R' = M * R * F  (M = flip Y, F = flip local X) keeps the matrix a proper rotation.
	local function mirrorCF(cf)
		local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
		return CFrame.new(x, 2 * plane - y, z, -r00, r01, r02, r10, -r11, -r12, -r20, r21, r22)
	end

	local function floorTopY(p)
		local cf = p.CFrame
		if cf.UpVector.Y < 0.95 then return nil end
		local s = p.Size
		if s.X < 6 or s.Z < 6 then return nil end
		if s.Y > math.min(s.X, s.Z) * 0.6 then return nil end
		local tr = (Orig[p] and Orig[p].Transparency) or p.Transparency
		if tr > 0.6 then return nil end
		return cf.Position.Y + s.Y * 0.5
	end

	local function makeClone(src)
		local c
		if src.ClassName == "Part" and #src:GetChildren() == 0 then
			c = Instance.new("Part")
			pcall(function() c.Shape = src.Shape end)
			c.Size = src.Size
			c.Color = src.Color
			c.Material = src.Material
			c.Transparency = src.Transparency
		else
			local ok, cl = pcall(function() return src:Clone() end)
			if not ok or not cl then return nil end
			for _, ch in ipairs(cl:GetChildren()) do
				if not (ch:IsA("DataModelMesh") or ch:IsA("SurfaceAppearance")) then
					ch:Destroy()
				end
			end
			c = cl
		end
		c.Name = "XG"
		c.Anchored = true
		c.CanCollide = false
		c.CanQuery = false
		c.CanTouch = false
		c.CastShadow = false
		c.Reflectance = 0
		Own[c] = true
		c.CFrame = mirrorCF(src.CFrame)
		return c
	end

	local function dropClone(src)
		local c = clones[src]
		if c then pcall(function() c:Destroy() end) end
		clones[src] = nil
		staticCF[src] = nil
	end

	local function clearClones()
		for src in pairs(clones) do dropClone(src) end
		dynSrc, dynDst = {}, {}
	end

	local function clearGlow()
		for p, l in pairs(glow) do
			pcall(function() l:Destroy() end)
			glow[p] = nil
		end
	end

	local function clearGloss()
		for p in pairs(GlossySet) do
			GlossySet[p] = nil
			if p.Parent then pcall(Core.processInstance, p) end
		end
	end

	-- indices of the n nearest entries (distances in dist[1..count])
	local function nearest(dist, count, n)
		local idx = {}
		for i = 1, count do idx[i] = i end
		table.sort(idx, function(a, b) return dist[a] < dist[b] end)
		local out = {}
		for i = 1, math.min(n, count) do out[i] = idx[i] end
		return out
	end

	local function rebuildDyn()
		local ds, dd = {}, {}
		for src, c in pairs(clones) do
			if src.Anchored then
				local cf = src.CFrame
				if staticCF[src] ~= cf then
					staticCF[src] = cf
					c.CFrame = mirrorCF(cf)
				end
			else
				ds[#ds + 1] = src
				dd[#dd + 1] = c
			end
		end
		dynSrc, dynDst = ds, dd
	end

	local function scanOnce()
		local wantGloss = S.refl_on
		local wantScene = S.refl_on and S.refl_scene
		local wantNeon = S.neon_on

		if not wantGloss and next(GlossySet) then clearGloss() end
		if not wantScene and next(clones) then clearClones() end
		if not wantNeon and next(glow) then clearGlow() end
		if not (wantGloss or wantNeon) then return end

		ensureFolder()
		Core.folder = folder
		local cam = Workspace.CurrentCamera
		local char = LocalPlayer.Character
		local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
		local center = (cam and cam.CFrame.Position) or (root and root.Position)
		local rayOrigin = (root and root.Position) or center
		if not center then return end

		-- 1. find the mirror plane (floor height under the player)
		if wantGloss then
			rp.FilterDescendantsInstances = char and { folder, char } or { folder }
			local hit = Workspace:Raycast(rayOrigin, Vector3.new(0, -500, 0), rp)
			if hit and hit.Normal.Y > 0.9 then
				local y = hit.Position.Y
				if not plane or math.abs(y - plane) > 0.15 then
					plane = y
					staticCF = {}
				end
			end
		end

		-- 2. query parts around the camera
		ovp.FilterDescendantsInstances = { folder }
		ovp.MaxParts = math.min(9000, S.refl_max * 2 + 600)
		local parts = Workspace:GetPartBoundsInRadius(center, S.refl_range, ovp)
		local cx, cy, cz = center.X, center.Y, center.Z

		-- 3. glossy floors
		local newGloss = {}
		if wantGloss and plane then
			local cands, cd, n = {}, {}, 0
			for i = 1, #parts do
				local p = parts[i]
				if not Own[p] then
					local top = floorTopY(p)
					if top and math.abs(top - plane) <= S.refl_tol and not Core.inCharacter(p) then
						local pos = p.Position
						local dx, dz = pos.X - cx, pos.Z - cz
						n = n + 1
						cands[n] = p
						cd[n] = dx * dx + dz * dz
					end
				end
			end
			if n > 400 then
				for _, k in ipairs(nearest(cd, n, 400)) do newGloss[cands[k]] = true end
			else
				for i = 1, n do newGloss[cands[i]] = true end
			end
		end
		for p in pairs(GlossySet) do
			if not newGloss[p] then
				GlossySet[p] = nil
				if p.Parent then pcall(Core.processInstance, p) end
			end
		end
		for p in pairs(newGloss) do
			if not GlossySet[p] then
				GlossySet[p] = true
				pcall(Core.processInstance, p)
			end
		end

		-- 4. mirrored scene clones
		if wantScene and plane then
			local cp, cd, n = {}, {}, 0
			local minDiag, chars = S.refl_minsize, S.refl_chars
			for i = 1, #parts do
				local p = parts[i]
				if not Own[p] and not newGloss[p] then
					local tr = (Orig[p] and Orig[p].Transparency) or p.Transparency
					if tr < 0.95 then
						local diag = p.Size.Magnitude
						local pos = p.Position
						if diag >= minDiag and diag < 2000 and pos.Y + diag * 0.5 > plane + 0.05
							and (chars or not Core.inCharacter(p)) then
							local dx, dy, dz = pos.X - cx, pos.Y - cy, pos.Z - cz
							n = n + 1
							cp[n] = p
							cd[n] = dx * dx + dy * dy + dz * dz
						end
					end
				end
			end

			local wanted = {}
			if n > S.refl_max then
				for _, k in ipairs(nearest(cd, n, S.refl_max)) do wanted[cp[k]] = true end
			else
				for i = 1, n do wanted[cp[i]] = true end
			end

			for src in pairs(clones) do
				if not wanted[src] or not src.Parent then dropClone(src) end
			end
			rebuildDyn()

			local made = 0
			for src in pairs(wanted) do
				if not clones[src] then
					local c = makeClone(src)
					if c then
						clones[src] = c
						c.Parent = folder
					end
					made = made + 1
					if made % 120 == 0 then
						task.wait()
						if Dead or not (S.refl_on and S.refl_scene) then return end
					end
				end
			end
			rebuildDyn()
		end

		-- 5. neon glow lights
		if wantNeon then
			local cp, cd, n = {}, {}, 0
			for i = 1, #parts do
				local p = parts[i]
				if not Own[p] then
					local m = (Orig[p] and Orig[p].Material) or p.Material
					if m == M_NEON and p.Transparency < 0.6 and p.Size.Magnitude >= 0.8 and not Core.inCharacter(p) then
						local d = p.Position - center
						n = n + 1
						cp[n] = p
						cd[n] = d:Dot(d)
					end
				end
			end
			local wanted = {}
			if n > S.neon_max then
				for _, k in ipairs(nearest(cd, n, S.neon_max)) do wanted[cp[k]] = true end
			else
				for i = 1, n do wanted[cp[i]] = true end
			end
			for p, l in pairs(glow) do
				if not wanted[p] or not p.Parent then
					pcall(function() l:Destroy() end)
					glow[p] = nil
				end
			end
			for p in pairs(wanted) do
				local l = glow[p]
				if not l or not l.Parent then
					l = Instance.new("PointLight")
					l.Name = "XG_Glow"
					Own[l] = true
					l.Parent = p
					glow[p] = l
				end
				if l.Color ~= p.Color then l.Color = p.Color end
				if l.Brightness ~= S.neon_bright then l.Brightness = S.neon_bright end
				if l.Range ~= S.neon_range then l.Range = S.neon_range end
				if l.Shadows ~= S.gpu_lightshadows then l.Shadows = S.gpu_lightshadows end
			end
		end
	end

	-- look of a glossy floor part (called from processPart)
	function Core.floorLook(p)
		local st = Styles[S.refl_style] or Styles["Wet Asphalt"]
		local col = st.color
		if not col then
			local o = Orig[p]
			local base = (o and o.Color) or p.Color
			local d = 1 - S.refl_dark
			col = Color3.new(base.R * d, base.G * d, base.B * d)
		end
		local tr
		if S.refl_scene then tr = math.clamp(S.refl_strength * 0.92, 0, 0.92) end
		return getMat(st.mat), col, S.refl_gloss, tr
	end

	-- re-mirror moving parts every frame (render step)
	function Core.reflFrame(dt)
		if not (S.refl_on and S.refl_scene) or not plane or #dynDst == 0 then return end
		accum = accum + dt
		if S.refl_hz < 60 and accum < 1 / S.refl_hz then return end
		accum = 0
		local n = #dynSrc
		local cfs = {}
		for i = 1, n do cfs[i] = mirrorCF(dynSrc[i].CFrame) end
		local ok = pcall(function()
			Workspace:BulkMoveTo(dynDst, cfs, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		if not ok then dynSrc, dynDst = {}, {} end -- rebuilt at next scan
	end

	function Core.scanLoop()
		task.spawn(function()
			while not Dead do
				local ok, err = pcall(scanOnce)
				if not ok then
					errCount = errCount + 1
					if errCount <= 3 then warn("[XG] reflection scan error: " .. tostring(err)) end
				end
				local waited = 0
				while waited < 0.5 and not Core.kick and not Dead do
					task.wait(0.1)
					waited = waited + 0.1
				end
				Core.kick = false
			end
		end)
	end

	function Core.destroyScanner()
		clearClones()
		clearGlow()
		for p in pairs(GlossySet) do GlossySet[p] = nil end
		if folder then pcall(function() folder:Destroy() end) end
		folder = nil
		Core.folder = nil
	end
end

------------------------------------------------------------------------
-- CHANGE ROUTING
------------------------------------------------------------------------
local Controls = {}
local function syncUI(keys)
	for _, k in ipairs(keys) do
		local c = Controls[k]
		if c then c.Set(S[k]) end
	end
end
local function keyList(set)
	local t = {}
	for k in pairs(set) do t[#t + 1] = k end
	return t
end

local INST_KEYS = {}
for _, k in ipairs({
	"noshadows", "notextures", "smooth", "noparticles", "nopostfx", "lowmesh", "noreflect",
	"sh_on", "surf_reflect", "gpu_precise", "gpu_lightshadows",
	"tex_on", "tex_pack", "tex_floor", "tex_wall", "tex_part",
	"tex_mat_floor", "tex_mat_wall", "tex_mat_part", "tex_usecolors", "tex_minsize", "tex_vary",
	"tex_custom_on", "tex_custom_id", "tex_custom_size",
}) do INST_KEYS[k] = true end

local GLOSS_LOOK = { refl_style = true, refl_gloss = true, refl_dark = true, refl_strength = true, refl_scene = true }
local SCAN_KEYS = {}
for _, k in ipairs({
	"refl_on", "refl_style", "refl_gloss", "refl_dark", "refl_strength", "refl_scene", "refl_range", "refl_max",
	"refl_hz", "refl_chars", "refl_minsize", "refl_tol", "neon_on", "neon_max", "neon_range", "neon_bright",
	"gpu_lightshadows",
}) do SCAN_KEYS[k] = true end

local glossToken = 0
local function scheduleGloss()
	glossToken = glossToken + 1
	local t = glossToken
	task.delay(0.08, function()
		if t ~= glossToken or Dead then return end
		for p in pairs(GlossySet) do
			if p.Parent then pcall(Core.processInstance, p) end
		end
	end)
end

local function changed(key)
	if SHADER_KEYS[key] then
		if key == "sh_on" then
			if S.sh_on then
				if S.sh_preset == "Off" then S.sh_preset = "Custom" end
			else
				S.sh_preset = "Off"
			end
			syncUI({ "sh_preset" })
		elseif S.sh_preset ~= "Custom" and S.sh_preset ~= "Off" then
			S.sh_preset = "Custom"
			syncUI({ "sh_preset" })
		end
	end
	if LOW_SET[key] and S.low_preset ~= "Custom" then
		S.low_preset = "Custom"
		syncUI({ "low_preset" })
	end
	if key == "tex_on" then
		if S.tex_on and S.tex_pack == "Off" then
			S.tex_pack = "Custom"
		elseif not S.tex_on then
			S.tex_pack = "Off"
		end
		syncUI({ "tex_pack" })
	end
	pcall(Core.applyGlobal)
	if INST_KEYS[key] then Core.scheduleRefresh(0.15) end
	if GLOSS_LOOK[key] then scheduleGloss() end
	if SCAN_KEYS[key] then Core.kick = true end
end

local function fullApply()
	pcall(Core.applyGlobal)
	Core.scheduleRefresh(0.05)
	Core.kick = true
end

