function Page:Slider(text, key, min, max, step, fmt, onSet)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = C.row, BorderSizePixel = 0, LayoutOrder = self:_next(),
	}, self.Frame)
	round(row, 7)
